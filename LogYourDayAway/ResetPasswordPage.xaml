<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LogYourDayAway.ViewModel"
             x:Class="LogYourDayAway.ResetPasswordPage"
             Title="Reset Password">
    <ScrollView>

        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

            <Label Text="Create New Password"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalOptions="Center" />

            <Label Text="Enter a new password for your journal."
                   FontSize="14"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20" />

            <Label Text="New Password" 
                   FontSize="14" 
                   Margin="2,0,0,5" />

            <Entry Placeholder="Enter new password"
                   Text="{Binding NewPassword}"
                   IsPassword="True" />

            <Label Text="Confirm Password" 
                   FontSize="14" 
                   Margin="2,10,0,5" />

            <Entry Placeholder="Confirm new password"
                   Text="{Binding ConfirmPassword}"
                   IsPassword="True" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource Error}"
                   HorizontalOptions="Center"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" />

            <Button Text="Save &amp; Unlock"
                    Command="{Binding SaveNewPasswordCommand}"
                    Margin="0,30,0,0"
                    HeightRequest="55" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>